{
  "name": "tecnoled-site",
  "version": "2.0.0",
  "description": "Site Tecno LED com cadastro, login, área do cliente, orçamentos e painel administrativo",
  "private": true,
  "main": "backend/server.js",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "db:init": "node backend/scripts/init-db.js",
    "db:seed": "node backend/scripts/seed.js",
    "criar-admin": "node backend/scripts/create-admin.js",
    "test": "node --test backend/tests/unit.test.js",
    "test:e2e": "node backend/tests/e2e.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16"
  }
}
